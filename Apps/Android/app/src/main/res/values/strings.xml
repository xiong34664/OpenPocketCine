    <!-- Pairing wizard -->
    <string name="pairing_body_1">Turn the camera on and keep the phone nearby. Pocket and Nano both appear. Choose the one you want.</string>
    <string name="pairing_body_2">If the camera shows Approve, tap it on that camera\'s screen. First-time pairing can wait up to 90 seconds.</string>
    <string name="pairing_body_3">We read the camera\'s network over Bluetooth, then join its Wi-Fi for you.</string>
    <string name="pairing_body_4">Exposure, LUTs and scopes go live as soon as the video link is up.</string>
    <string name="pairing_approve_1">Look for an Approve / pairing prompt</string>
    <string name="pairing_approve_2">Tap it on the camera screen</string>
    <string name="pairing_join_1">Leave the camera on. It brings up its own Wi-Fi</string>
    <string name="pairing_join_2">On 5.8 GHz that can take about a minute; we keep trying</string>

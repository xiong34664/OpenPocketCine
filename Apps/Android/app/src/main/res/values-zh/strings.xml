    <string name="app_name">OpenPocketCine</string>
    <string name="startup_wordmark">OPENPOCKETCINE</string>

    <!-- Pairing wizard -->
    <string name="pairing_body_1">打开相机，让手机靠近。Pocket 和 Nano 都会出现，选择你想要的那台。</string>
    <string name="pairing_body_2">如果相机显示「批准」（Approve），在相机屏幕上点它。首次配对可能需要等待最多 90 秒。</string>
    <string name="pairing_body_3">我们通过蓝牙读取相机的网络，然后帮你加入它的 Wi-Fi。</string>
    <string name="pairing_body_4">视频链路一建立，曝光、LUT 和示波器就会实时生效。</string>
    <string name="pairing_approve_1">寻找「批准 / 配对」提示</string>
    <string name="pairing_approve_2">在相机屏幕上点它</string>
    <string name="pairing_join_1">让相机保持开启，它会自己建立 Wi-Fi</string>
    <string name="pairing_join_2">在 5.8 GHz 下大约需要一分钟；我们会持续尝试</string>
